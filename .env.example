# Copy to .env only for a fresh checkout without an existing .env.
# Never commit real secrets. Environment variables override root .env.
FORKCAST_DB_PATH=data/forkcast.sqlite3
FORKCAST_SECURE_COOKIE=false
FORKCAST_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# All three settings per service are required for configured=true.
# Use the assigned OpenAI-compatible API root (often ending in /v1).
# No endpoints or keys are included in source control.
FORKCAST_TEXT_BASE_URL=
FORKCAST_TEXT_API_KEY=
FORKCAST_TEXT_MODEL=
FORKCAST_VISION_BASE_URL=
FORKCAST_VISION_API_KEY=
FORKCAST_VISION_MODEL=
